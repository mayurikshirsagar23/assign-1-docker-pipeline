pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t assign-1-docker .'
            }
        }

        stage('Docker Run') {
            steps {
                sh 'docker run -d --name assign-1-container -p 8080:80 assign-1-docker'
            }
        }
    }
}
